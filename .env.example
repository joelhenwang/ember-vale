# Ember Vale local environment. Copy to .env and fill real values. Never commit .env.
#
# Host-side vs container-side addresses (they are DIFFERENT):
# - Containers reach the database at db:5432 (compose service name).
# - Host processes reach it at localhost:5433 (mapped port).
# The typed settings key is WORLDSIM_DATABASE__URL (prefix WORLDSIM_,
# nested delimiter __). The backend and Alembic read ONLY that key; a bare
# DATABASE_URL is ignored by the application, so set the typed key.
POSTGRES_DB=embervale
POSTGRES_USER=embervale_app
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5433
API_PORT=8101
# Host-run backend (uv run ... python -m worldsim.interfaces.cli serve):
# export these first, e.g. `set -a; source .env; set +a` (bash) or equivalent.
WORLDSIM_DATABASE__URL=postgresql+asyncpg://embervale_app:changeme-local-only@localhost:5433/embervale
# Typed settings (prefix WORLDSIM_, nested delimiter __).
WORLDSIM_APP__ENVIRONMENT=local
WORLDSIM_APP__HOST=127.0.0.1
# Manual live probe only (never a gate): WORLDSIM_MODEL_LIVE_PROBE=1
# The engine refuses a public bind (compose api binds 0.0.0.0) unless BOTH lines
# below are set. Every request then needs Authorization: Bearer <key>
# (health probes exempt). This guard must stay on for network-exposed deploys.
WORLDSIM_SECURITY__PUBLIC_BIND_ALLOW=true
WORLDSIM_SECURITY__API_KEY=change-me-before-run

# Live narration (maintainer only). The backend reads ONLY these typed
# names; bare OPENROUTER_* names are ignored. Keep the profile on fake
# until a real key is set, then recreate the api:
# docker compose up -d --force-recreate api
WORLDSIM_PROVIDER__ACTIVE_PROFILE=fake
WORLDSIM_PROVIDER__OPENROUTER_API_KEY=
WORLDSIM_PROVIDER__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WORLDSIM_PROVIDER__OPENROUTER_MODEL=openrouter/auto
