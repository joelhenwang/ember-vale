# Ember Vale local environment. Copy to .env and fill real values. Never commit .env.
POSTGRES_DB=embervale
POSTGRES_USER=embervale
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5433
API_PORT=8101
# Async SQLAlchemy URL used by the app (password comes from your local .env).
DATABASE_URL=postgresql+asyncpg://embervale:changeme-local-only@localhost:5433/embervale
# Typed settings (prefix WORLDSIM_, nested delimiter __).
WORLDSIM_APP__ENVIRONMENT=local
WORLDSIM_APP__HOST=127.0.0.1
WORLDSIM_APP__PORT=8000
# Manual live probe only (never a gate): WORLDSIM_MODEL_LIVE_PROBE=1
# Compose api binds 0.0.0.0, so a network-exposed deploy refuses to start
# without both lines below. Every request then needs Authorization: Bearer <key>
# (health probes exempt).
# WORLDSIM_SECURITY__PUBLIC_BIND_ALLOW=true
# WORLDSIM_SECURITY__API_KEY=change-me-before-deploy
